generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Imperfeccion {
  id                    Int                    @id @default(autoincrement())
  nombre                String                 @unique @db.VarChar(50)
  productoImperfeccion ProductoImperfeccion[]

  @@map("imperfecciones")
}

model Producto {
  id                    Int                    @id @default(autoincrement())
  nombre                String                 @db.VarChar(100)
  marca                 String?                @db.VarChar(50)
  descripcion           String?
  precio                Decimal?               @db.Decimal(10, 2)
  imagenUrl             String?                @map("imagen_url")
  productoImperfeccion ProductoImperfeccion[]

  @@map("productos")
}

model ProductoImperfeccion {
  productoId     Int          @map("producto_id")
  imperfeccionId Int          @map("imperfeccion_id")
  imperfeccion   Imperfeccion @relation(fields: [imperfeccionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  producto       Producto     @relation(fields: [productoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([productoId, imperfeccionId])
  @@map("producto_imperfeccion")
}
